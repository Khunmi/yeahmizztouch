APP_NAME="Your Salon"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

# Database
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=salon_booking
DB_USERNAME=postgres
DB_PASSWORD=0121

# Redis (Queue)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
QUEUE_CONNECTION=redis

# Sessions
SESSION_DRIVER=database
SESSION_LIFETIME=120

# Stripe
STRIPE_KEY=pk_test_xxxxx
STRIPE_SECRET=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# Email
MAIL_MAILER=smtp
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="bookings@yoursalon.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─────────────────────────────────────────────────────────────────────────────
# SALON CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────

# Salon name (shown in emails, header)
SALON_NAME="Your Salon"

# Timezone for displaying times to clients
SALON_TIMEZONE=America/New_York

# Email to receive new booking alerts
SALON_ADMIN_EMAIL=owner@yoursalon.com

# Minutes between appointments (buffer time)
BUFFER_MINUTES=15

# Time slot interval for calendar (minutes)
SLOT_INTERVAL_MINUTES=15

# How long a slot hold lasts during checkout (minutes)
SLOT_HOLD_MINUTES=15

# Minimum hours in advance clients can book
MIN_ADVANCE_HOURS=2

# Maximum days in advance clients can book
MAX_ADVANCE_DAYS=60

# Require full payment (true) or deposit only (false)
REQUIRE_FULL_PAYMENT=false

# Default deposit percentage (if not requiring full payment)
DEPOSIT_PERCENTAGE=25

# Hours before appointment that cancellation is allowed
CANCELLATION_HOURS=24
